{
  "name": "gemini-studio-toolkit",
  "version": "1.0.0",
  "description": "Bộ công cụ sáng tạo đa năng 4-trong-1: Xóa Watermark AI, Chèn Logo, Xóa Phông AI (Background Removal) & Chuyển đổi Media / Tài liệu Word sang PDF 100% Offline.",
  "main": "main.js",
  "author": "Trịnh Hải Hoàn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/haihoan2874/Gemini-Studio-Toolkit.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-packager . \"Gemini Studio Toolkit\" --platform=win32 --arch=x64 --out=dist --overwrite --icon=assets/icon.ico --ignore=node_modules --ignore=dist --ignore=\\.agent --ignore=convert-icon.mjs --ignore=create-ico.js --ignore=\\.zip$ --ignore=test-.*\\.js --asar",
    "build:dir": "electron-packager . \"Gemini Studio Toolkit\" --platform=win32 --arch=x64 --out=dist --overwrite --icon=assets/icon.ico --ignore=node_modules --ignore=dist --ignore=\\.agent --ignore=\\.zip$ --ignore=test-.*\\.js",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "electron": "^36.4.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.1",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "com.trinhhaihoan.gemini-studio-toolkit",
    "productName": "Gemini Studio Toolkit",
    "copyright": "Copyright © 2025 Trịnh Hải Hoàn",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "app.js",
      "assets/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gemini Studio Toolkit",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeader": "assets/icon.ico",
      "license": null,
      "language": "1033"
    },
    "portable": {
      "artifactName": "GeminiStudioToolkit-Portable-${version}.exe"
    }
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffmpeg-installer/win32-x64": "^4.1.0",
    "@imgly/background-removal-node": "^1.4.5",
    "@pilio/gemini-watermark-remover": "^1.0.33",
    "@xenova/transformers": "^2.17.2"
  }
}
